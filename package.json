{
    "name": "sv5ui-plus",
    "version": "5.0.1",
    "description": "Community companion components and hooks for SV5UI and Svelte 5",
    "packageManager": "bun@1.3.14",
    "author": "asphum",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/asphum/sv5ui-plus.git"
    },
    "homepage": "https://sv5ui-plus.vercel.app/",
    "publishConfig": {
        "access": "public"
    },
    "bugs": {
        "url": "https://github.com/asphum/sv5ui-plus/issues"
    },
    "scripts": {
        "dev": "vite dev --port 3000",
        "predev": "bun run paraglide:compile",
        "dev:docs": "vite dev --host 0.0.0.0 --port 4173",
        "predev:docs": "bun run paraglide:compile",
        "build": "vite build && bun run prepack",
        "prebuild": "bun run paraglide:compile",
        "preview": "vite preview",
        "prepare": "bun run paraglide:compile && svelte-kit sync || echo ''",
        "prepack": "svelte-kit sync && svelte-package && bun run package:mcp && publint",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "precheck": "bun run paraglide:compile",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "biome check .",
        "format": "biome format --write .",
        "lint:fix": "biome check --write .",
        "test:unit": "vitest",
        "pretest:unit": "bun run paraglide:compile",
        "test": "bun run test:unit -- --run",
        "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations --strategy cookie globalVariable baseLocale",
        "package:mcp": "node ./scripts/package-mcp.mjs",
        "mcp:sv5ui-plus-docs": "node ./mcp/sv5ui-plus-docs/server.mjs",
        "changelog:template": "node ./scripts/changelog-template.mjs",
        "release:verify": "bun run check && bun run prepack && npm pack --dry-run",
        "release:verify:full": "bun run check && bun run test && bun run prepack && npm pack --dry-run",
        "release": "node ./scripts/release.mjs",
        "release:patch": "node ./scripts/release.mjs patch",
        "release:minor": "node ./scripts/release.mjs minor",
        "release:major": "node ./scripts/release.mjs major",
        "release:patch:full": "node ./scripts/release.mjs patch --full",
        "release:minor:full": "node ./scripts/release.mjs minor --full",
        "release:major:full": "node ./scripts/release.mjs major --full",
        "release:patch:dry": "node ./scripts/release.mjs patch --dry-run",
        "public": "node ./scripts/release.mjs public",
        "public:minor": "node ./scripts/release.mjs public minor",
        "public:major": "node ./scripts/release.mjs public major",
        "public:full": "node ./scripts/release.mjs public --full",
        "public:dry": "node ./scripts/release.mjs public --dry-run",
        "public:minor:full": "node ./scripts/release.mjs public minor --full",
        "public:major:full": "node ./scripts/release.mjs public major --full",
        "public:minor:dry": "node ./scripts/release.mjs public minor --dry-run",
        "public:major:dry": "node ./scripts/release.mjs public major --dry-run",
        "clean": "rm -rf dist node_modules build .svelte-kit bun.lock",
        "kill": "PORT=${PORT:-3000}; lsof -ti:$PORT | xargs kill -9 2>/dev/null || true",
        "kill:docs": "for p in 4173 4174 4175; do lsof -ti:$p | xargs kill -9 2>/dev/null || true; done"
    },
    "files": [
        "dist",
        "!dist/**/*.test.*",
        "!dist/**/*.spec.*",
        "!dist/**/*TestWrapper*"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "svelte": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "bin": {
        "sv5ui-plus-mcp-docs": "./dist/mcp/server.mjs",
        "sv5ui-plus-mcp-install-template": "./dist/mcp/install-template.mjs"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "svelte": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./compat": {
            "types": "./dist/compat.d.ts",
            "svelte": "./dist/compat.js",
            "default": "./dist/compat.js"
        },
        "./mcp/server": {
            "default": "./dist/mcp/server.mjs"
        },
        "./mcp/cursor-template": {
            "default": "./dist/mcp/cursor.mcp.json"
        },
        "./mcp/install-template": {
            "default": "./dist/mcp/install-template.mjs"
        },
        "./editor": {
            "types": "./dist/editor.d.ts",
            "svelte": "./dist/editor.js",
            "default": "./dist/editor.js"
        },
        "./theme.css": {
            "import": "./dist/theme.css",
            "default": "./dist/theme.css"
        }
    },
    "peerDependencies": {
        "@sveltejs/kit": "^2.0.0",
        "sv5ui": "^2.5.0",
        "svelte": "^5.0.0",
        "tailwindcss": "^4.0.0"
    },
    "peerDependenciesMeta": {
        "@sveltejs/kit": {
            "optional": true
        }
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.8",
        "@inlang/paraglide-js": "^2.24.1",
        "@sveltejs/adapter-vercel": "^6.3.4",
        "@sveltejs/kit": "^2.70.2",
        "@sveltejs/package": "^2.5.8",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.2.0",
        "@vitest/browser-playwright": "^4.1.10",
        "playwright": "^1.62.1",
        "publint": "^0.3.23",
        "sv5ui": "^2.5.0",
        "svelte": "^5.56.9",
        "svelte-check": "^4.7.6",
        "tailwindcss": "^4.3.3",
        "typescript": "6.0.3",
        "vite": "^8.2.1",
        "vitest": "^4.1.10",
        "vitest-browser-svelte": "^3.0.0"
    },
    "keywords": [
        "svelte",
        "svelte5",
        "svelte-components",
        "primitives",
        "ui",
        "ui-library",
        "components",
        "component-library",
        "tailwindcss",
        "tailwind",
        "design-system",
        "typescript",
        "dark-mode",
        "accessible"
    ],
    "dependencies": {
        "@dnd-kit/abstract": "^0.5.0",
        "@dnd-kit/dom": "^0.5.0",
        "@dnd-kit/helpers": "^0.5.0",
        "@dnd-kit/svelte": "^0.5.0",
        "@internationalized/date": "^3.12.3",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "apexcharts": "^6.8.0",
        "bits-ui": "^2.18.1",
        "shiki": "^4.4.3",
        "tailwind-merge": "^3.6.0",
        "tailwind-variants": "^3.3.1",
        "zod": "^4.4.3"
    },
    "overrides": {
        "tailwind-merge": "^3.6.0",
        "typescript": "6.0.3"
    }
}
